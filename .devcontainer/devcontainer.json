{
    "name": "claude-plugins",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "mounts": [
        "source=claude-code-config-${localWorkspaceFolderBasename}-${devcontainerId},target=/home/node/.claude,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "chat.permissions.default": "autoApprove"
            }
        }
    }
}
